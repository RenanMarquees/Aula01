# Copie este arquivo para .env.local e preencha (ou cadastre os mesmos nomes na Vercel).
# Sem estes dois valores, o cardápio roda em MODO DEMONSTRAÇÃO (dados só no navegador).

# Endereço do projeto no Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "publishable" (ou "anon public", no nome antigo). Pode ficar no site; a segurança vem das regras do banco.
# NUNCA coloque aqui a chave "secret" nem a "service_role".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
